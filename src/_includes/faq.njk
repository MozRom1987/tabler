                                {% set faq_villages = ['Skołoszów', 'Korczowa', 'Orły', 'Stubno', 'Duńkowice', 'Sośnica', 'Ostrów', 'Chotyniec', 'Michałówka', 'Kaszyce'] %}
                            {% elif city_name == 'Pruchnik' %}
                                {% set faq_villages = ['Roźwienica', 'Hawłowice', 'Jodłówka', 'Rudołowice', 'Bystrowice', 'Kramarzówka', 'Węgierka', 'Rzeplin', 'Tyniowice', 'Świebodna'] %}
                            {% elif city_name == 'Bircza' %}
                                {% set faq_villages = ['Fredropol', 'Rybotycze', 'Huwniki', 'Kuźmina', 'Leszczawa Dolna', 'Jawornik Ruski', 'Lipa', 'Nowe Sady', 'Kalwaria Pacławska', 'Sierakośce'] %}
                            {% elif city_name == 'Dubiecko' %}
